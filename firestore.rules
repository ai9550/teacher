rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 既有課堂工具集合（沿用目前 Firebase Console 規則）
    match /wordcloud_words/{document} {
      allow read, write: if true;
    }
    match /snake_players/{document} {
      allow read, write: if true;
    }
    match /snake_food/{document} {
      allow read, write: if true;
    }
    match /fps_players/{document} {
      allow read, write: if true;
    }
    match /fps_zombies/{document} {
      allow read, write: if true;
    }
    // 貪食蛇、射擊遊戲的房間（房間碼、房主設定、本局狀態），沿用相同的課堂開放規則
    match /snake_rooms/{document} {
      allow read, write: if true;
    }
    match /fps_rooms/{document} {
      allow read, write: if true;
    }

    // 多人坦克大戰：匿名登入玩家才能存取自己的房間資料
    match /tankRooms/{roomId} {
      function signedIn() { return request.auth != null; }
      function roomPath() { return /databases/$(database)/documents/tankRooms/$(roomId); }
      // Firestore 每個請求最多 10 次 get()/exists()；房主檢查只用 1 次。
      function isHost() {
        return signedIn() && get(roomPath()).data.hostUid == request.auth.uid;
      }
      // 只用 get()（不先 exists()），6 個座位共 6 次讀取；空座位產生的錯誤在 || 中會被略過。
      // 原本 exists()+get() 共 12 次，第 6 位玩家（seats/5）會超過上限而被拒絕。
      function seatIs(n) {
        return get(/databases/$(database)/documents/tankRooms/$(roomId)/seats/$(n)).data.uid == request.auth.uid;
      }
      function isMember() {
        return signedIn() && (seatIs('0') || seatIs('1') || seatIs('2') || seatIs('3') || seatIs('4') || seatIs('5'));
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow update: if isHost()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'level', 'hostBeat']);
      allow delete: if false;

      match /seats/{seatId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && seatId in ['0', '1', '2', '3', '4', '5']
          && request.resource.data.uid == request.auth.uid
          // 遊戲進行中也能加入；只要房間存在即可佔用空座位
          && getAfter(roomPath()).data.hostUid is string
          && (seatId != '0' || getAfter(roomPath()).data.hostUid == request.auth.uid || getAfter(roomPath()).data.get('hostPlays', true) == false);
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(roomPath()).data.status == 'lobby';
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isHost());
      }

      match /state/{stateId} {
        allow read: if isMember() || isHost();
        allow create, update: if isHost() && stateId == 'world';
        allow delete: if false;
      }

      match /inputs/{playerUid} {
        allow read: if signedIn() && (request.auth.uid == playerUid || isHost());
        allow create, update: if isMember() && request.auth.uid == playerUid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember() && request.auth.uid == playerUid;
      }

      match /questions/{playerUid} {
        allow read: if isMember() && (request.auth.uid == playerUid || isHost());
        allow create, update, delete: if isHost();
      }

      match /privateAnswers/{playerUid} {
        allow read, write: if isHost();
      }

      match /answers/{playerUid} {
        allow read: if isMember() && (request.auth.uid == playerUid || isHost());
        allow create, update: if isMember() && request.auth.uid == playerUid
          && request.resource.data.keys().hasOnly(['id', 'answer', 'submittedAt']);
        allow delete: if isMember() && (request.auth.uid == playerUid || isHost());
      }
    }

    // 其他集合預設禁止存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
